# ==============================================================================
# Local Database QA System - Environment Configuration
# ==============================================================================
# Rename this file to .env to customize local server parameters.

# Application Server Port (Default: 5000)
PORT=5000

# Flask Secret Key for Session Signing (Generate a secure random string for production)
SECRET_KEY=local-database-qa-system-secret-key-998877

# Ollama Local LLM Server Endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Default Model Checkpoint to load from Ollama (e.g. qwen2.5-coder:latest, llama3.2:latest)
DEFAULT_OLLAMA_MODEL=qwen2.5-coder:latest

# Sentence-Transformers Embedding Model for ChromaDB Vector Store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Concurrency Worker Threads for Production Waitress Server
WAITRESS_THREADS=16

# Persistent Relational Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Leave blank to use local fallback SQLite auth.db
DATABASE_URL=postgresql://amypo_user:amypo_secure_password_2026@localhost:5432/amypo_db

# Dedicated ChromaDB Vector Server (Client/Server Mode)
# Leave blank to use local embedded directory vector_db/
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_HTTP_PORT=8000
CHROMA_SERVER_SSL=false
# CHROMA_SERVER_AUTH_CREDENTIALS=your-bearer-token
